                    "path": ["api", "alerts"],
                    "query": [{ "key": "unread", "value": "1" }]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('200 OK', () => pm.response.to.have.status(200));",
                            "",
                            "const json = pm.response.json();",
                            "",
                            "pm.test('paginated shape', () => {",
                            "  pm.expect(json.data).to.be.an('array');",
                            "  pm.expect(json).to.have.property('current_page');",
                            "  pm.expect(json).to.have.property('total');",
                            "});",
                            "",
                            "pm.test('all returned alerts are unread', () => {",
                            "  json.data.forEach((a) => pm.expect(a.read_at).to.be.null);",
                            "});",
                            "",
                            "const seeded = json.data.find((a) => a.disease === 'API Smoke Test Disease');",
                            "",
                            "pm.test('seeded outbreak alert is present', () => {",
                            "  pm.expect(seeded, 'seeded alert').to.exist;",
                            "});",
                            "",
                            "pm.test('alert has expected fields', () => {",
                            "  ['id', 'message', 'severity', 'disease', 'municipality', 'outbreak_id', 'created_at', 'read_at']",
                            "    .forEach((k) => pm.expect(seeded).to.have.property(k));",
                            "  pm.expect(seeded.severity).to.be.oneOf(['low', 'medium', 'high']);",
                            "});",
                            "",
                            "if (seeded) pm.collectionVariables.set('farmerAlertId', seeded.id);"
                        ]
                    }
                }
            ]
